<collaboration id="col_asis"><participant id="part_asis" name="AS-IS - Manutenção por calendário (Motiva Trilhos)" processRef="asis"/></collaboration>
<process id="asis" name="AS-IS - Manutenção por calendário (Motiva Trilhos)" isExecutable="false"><laneSet id="ls_asis"><lane id="asis_lane0" name="Planejamento da manutenção"><flowNodeRef>a_s</flowNodeRef><flowNodeRef>a_t1</flowNodeRef></lane><lane id="asis_lane1" name="Equipe de campo"><flowNodeRef>a_t2</flowNodeRef><flowNodeRef>a_t3</flowNodeRef><flowNodeRef>a_t4</flowNodeRef><flowNodeRef>a_t5</flowNodeRef><flowNodeRef>a_e1</flowNodeRef><flowNodeRef>a_t7</flowNodeRef><flowNodeRef>a_t8</flowNodeRef><flowNodeRef>a_e2</flowNodeRef></lane><lane id="asis_lane2" name="Engenharia / Operação"><flowNodeRef>a_s2</flowNodeRef><flowNodeRef>a_t6</flowNodeRef></lane></laneSet><startEvent id="a_s" name="Data do ciclo (inspeção 6 meses / manutenção 1 e 2 anos)"><outgoing>af1</outgoing><timerEventDefinition id="td_a_s"/></startEvent><task id="a_t1" name="Programar N1, N2 e N3 para todas as máquinas"><incoming>af1</incoming><outgoing>af2</outgoing></task><task id="a_t2" name="Deslocar equipe até cada máquina (com ou sem sinal de falha)"><incoming>af2</incoming><outgoing>af3</outgoing></task><task id="a_t3" name="Medir manualmente corrente, força, tempo de manobra e isolamento"><incoming>af3</incoming><outgoing>af4</outgoing></task><task id="a_t4" name="Executar roteiro N1/N2/N3 (ajustes, lubrificação, trocas)"><incoming>af4</incoming><outgoing>af5</outgoing></task><task id="a_t5" name="Registrar inspeção"><incoming>af5</incoming><outgoing>af6</outgoing></task><endEvent id="a_e1" name="Ciclo concluído"><incoming>af6</incoming></endEvent><startEvent id="a_s2" name="Falha da máquina entre ciclos"><outgoing>af7</outgoing></startEvent><task id="a_t6" name="Interditar a via e acionar manutenção corretiva emergencial"><incoming>af7</incoming><outgoing>af8</outgoing></task><task id="a_t7" name="Executar manutenção corretiva"><incoming>af8</incoming><outgoing>af9</outgoing></task><task id="a_t8" name="Registrar causa em texto livre (não padronizado)"><incoming>af9</incoming><outgoing>af10</outgoing></task><endEvent id="a_e2" name="Máquina restabelecida"><incoming>af10</incoming></endEvent><sequenceFlow id="af1" name="" sourceRef="a_s" targetRef="a_t1"/><sequenceFlow id="af2" name="" sourceRef="a_t1" targetRef="a_t2"/><sequenceFlow id="af3" name="" sourceRef="a_t2" targetRef="a_t3"/><sequenceFlow id="af4" name="" sourceRef="a_t3" targetRef="a_t4"/><sequenceFlow id="af5" name="" sourceRef="a_t4" targetRef="a_t5"/><sequenceFlow id="af6" name="" sourceRef="a_t5" targetRef="a_e1"/><sequenceFlow id="af7" name="" sourceRef="a_s2" targetRef="a_t6"/><sequenceFlow id="af8" name="" sourceRef="a_t6" targetRef="a_t7"/><sequenceFlow id="af9" name="" sourceRef="a_t7" targetRef="a_t8"/><sequenceFlow id="af10" name="" sourceRef="a_t8" targetRef="a_e2"/></process>
