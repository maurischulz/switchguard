        "lineageTag": "50543f50-7409-4072-963a-5eb5cccd65ba",
        "measures": [
          {
            "name": "Qtd Vermelho",
            "expression": "CALCULATE(COUNTROWS(maquinas), maquinas[nivel] = \"Vermelho\") + 0",
            "formatString": "0",
            "lineageTag": "ac0f1fe0-4959-4b41-8361-63a0d084c44b"
          },
          {
            "name": "Qtd Amarelo",
            "expression": "CALCULATE(COUNTROWS(maquinas), maquinas[nivel] = \"Amarelo\") + 0",
            "formatString": "0",
            "lineageTag": "ec2935a7-9213-4ebe-abbd-29ba19d36f55"
          },
          {
            "name": "Qtd Verde",
            "expression": "CALCULATE(COUNTROWS(maquinas), maquinas[nivel] = \"Verde\") + 0",
            "formatString": "0",
            "lineageTag": "2038e535-ca82-49c4-9320-a096ccd5dd01"
          },
          {
            "name": "Custo corretivo evitado",
            "expression": "SUMX(FILTER(maquinas, maquinas[nivel] <> \"Verde\"), maquinas[prob] * maquinas[custo_falha])",
            "formatString": "\"R$ \"#,0",
            "lineageTag": "d82fc836-eabe-475c-a3a4-08358d3fe936"
          },
          {
            "name": "Cor Nivel",
            "expression": "SWITCH(SELECTEDVALUE(maquinas[nivel]), \"Vermelho\", \"#E76F51\", \"Amarelo\", \"#E9C46A\", \"Verde\", \"#2A9D8F\", \"#FFFFFF\")",
            "lineageTag": "ba49bb92-3706-4062-b5bb-a1ecd9b78e67"
          },
          {
            "name": "Cor Fonte Nivel",
            "expression": "IF(SELECTEDVALUE(maquinas[nivel]) = \"Amarelo\", \"#3D3A1E\", \"#FFFFFF\")",
            "lineageTag": "09ec2ceb-26d3-4457-a21d-45a3ba0e58af"
          },
          {
            "name": "Cor Prob",
            "expression": "SWITCH(SELECTEDVALUE(maquinas[nivel]), \"Vermelho\", \"#E76F51\", \"Amarelo\", \"#B8860B\", \"#2A9D8F\")",
            "lineageTag": "7d42abfd-179e-483c-8918-c83029b8d08b"
          },
          {
            "name": "Probabilidade 30 dias",
            "expression": "SELECTEDVALUE(maquinas[prob])",
            "formatString": "0%",
            "lineageTag": "d8f67e63-e3ac-4551-9ec6-4c4607c1d77b"
          },
          {
            "name": "Nivel de risco",
            "expression": "SELECTEDVALUE(maquinas[nivel], \"-\")",
            "lineageTag": "34a56d67-a147-47c7-845d-e1c239a373d1"
          },
          {
            "name": "Health score",
            "expression": "SELECTEDVALUE(maquinas[health_score]) & \" / 100\"",
            "lineageTag": "a4d29750-d4ad-4508-9ad3-be369b19a01f"
          },
          {
            "name": "Idade",
            "expression": "SELECTEDVALUE(maquinas[idade_anos]) & \" anos\"",
            "lineageTag": "856d429d-5360-4c7c-8068-5f853e047f6f"
          },
          {
            "name": "Manobras por dia",
            "expression": "SELECTEDVALUE(maquinas[manobras_dia])",
            "formatString": "0",
            "lineageTag": "3d5a0133-bb79-4934-8209-b362c7f43f56"
          },
          {
            "name": "Falhas 12 meses",
            "expression": "SELECTEDVALUE(maquinas[falhas_12m])",
            "formatString": "0",
            "lineageTag": "696ff420-9911-4f66-860f-3ba11ce689c7"
          },
          {
            "name": "Ultima manutencao",
            "expression": "SELECTEDVALUE(maquinas[ultima_manutencao], \"-\")",
            "lineageTag": "53d33574-3b15-411e-b08e-a4ee2541c7c0"
          },
          {
            "name": "Titulo detalhe",
            "expression": "SELECTEDVALUE(maquinas[maquina], \"Selecione uma máquina\") & \"  ·  Região \" & SELECTEDVALUE(maquinas[regiao], \"-\") & \"  ·  Tipo \" & SELECTEDVALUE(maquinas[tipo_amv], \"-\")",
            "lineageTag": "832de551-5b32-4a4a-8658-034881947b49"
          },
          {
            "name": "Tempo de manobra (s)",
            "expression": "AVERAGE(medicoes[tempo_manobra])",
            "formatString": "0.00",
            "lineageTag": "f48028ae-6d6e-49af-8159-ffe856800047"
          },
          {
            "name": "Faixa max fabricante",
            "expression": "AVERAGE(medicoes[faixa_max])",
            "formatString": "0.00",
            "lineageTag": "be6ffe95-d63d-455d-bd29-da74ffda2048"
          },
          {
            "name": "Faixa min fabricante",
            "expression": "AVERAGE(medicoes[faixa_min])",
            "formatString": "0.00",
            "lineageTag": "08063258-cc67-468b-8023-b97521362112"
          },
          {
            "name": "Contribuicao SHAP",
            "expression": "SUM(fatores[contribuicao])",
            "formatString": "+0.00;-0.00;0.00",
            "lineageTag": "5743c882-abb1-47bc-b2cf-2975fb77c14c"
          },
          {
            "name": "Cor SHAP",
            "expression": "VAR c = [Contribuicao SHAP] RETURN IF(c >= 0.15, \"#E76F51\", IF(c > 0, \"#F4A261\", \"#2A9D8F\"))",
            "lineageTag": "78550f2f-8ac5-4e47-b2e2-19fff3f4b986"
          },
          {
            "name": "Corrente ultima manobra",
            "expression": "AVERAGE(curva[corrente_ultima])",
            "formatString": "0.00",
            "lineageTag": "22a726e9-e3bd-4858-8b1a-de0982c2b53c"
          },
          {
            "name": "Assinatura normal",
            "expression": "AVERAGE(curva[corrente_normal])",
            "formatString": "0.00",
            "lineageTag": "5d0e8c8a-e89b-4b48-99e5-45758ea489ab"
          },
          {
            "name": "Alertas ativos",
            "expression": "COUNTROWS(alertas) + 0",
            "formatString": "0",
            "lineageTag": "00bdd5e6-ab9e-42bf-a8ac-670c08660e39"
          },
          {
            "name": "Cor Nivel Alerta",
            "expression": "SWITCH(SELECTEDVALUE(alertas[nivel]), \"Vermelho\", \"#E76F51\", \"Amarelo\", \"#E9C46A\", \"#FFFFFF\")",
            "lineageTag": "c7a39142-cff5-499e-a09a-c6d5f6735264"
          },
          {
            "name": "Cor Fonte Alerta",
